# Copy to .env.local for local development. In Vercel, set these as
# Project -> Settings -> Environment Variables instead (they're all
# NEXT_PUBLIC_*, safe to expose to the browser -- there is no server-side
# secret anywhere in this app, by design; every real secret lives in
# HiveMind-server).

# Where HiveMind-server is deployed, including the /v1 prefix.
NEXT_PUBLIC_API_BASE=http://localhost:8080/v1

# From the Firebase project console (Project settings -> General -> your web app).
# Leave unset and the /activate page shows a "not configured yet" message
# instead of crashing -- lets this site build and deploy before a Firebase
# project exists.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# "sandbox" until Cashfree production KYC is approved, then "production".
NEXT_PUBLIC_CASHFREE_MODE=sandbox
